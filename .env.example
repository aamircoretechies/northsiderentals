VITE_APP_NAME=northsiderentals
VITE_APP_VERSION=9.2.6

## API (required) — use Northside bookings API, NOT rcm-api.coretechiestest.org
# VITE_API_BASE_URL=https://rcm-api.coretechiestest.org/api/v1

# Quote → booking after Windcave: `bookings/edit` (default) or `quotations/convert`
# VITE_QUOTE_CONVERT_ENDPOINT=quotations/convert

# Must match API PAYMENT_SUCCESS_REDIRECT (GET /payments/complete browser redirect)
# VITE_PAYMENT_SUCCESS_REDIRECT=https://your-site.com/cars/checkout/success
# Public app URL when dev runs on localhost but Windcave must redirect to a reachable host
# VITE_PUBLIC_APP_URL=https://your-site.com

# Dev only: Vite proxy target for `/api` (default: api.bookings.northsiderentals.com.au)
# VITE_DEV_PROXY_TARGET=https://rcm-api.coretechiestest.org

